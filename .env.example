# Copie ce fichier en .env.local (local) ou renseigne ces variables dans Vercel → Settings → Environment Variables.
# Mot de passe de l'app (12 caractères minimum, idéalement une phrase longue)
APP_PASSWORD=
# Secret de signature des sessions (32 caractères aléatoires minimum)
SESSION_SECRET=
# Adresse /exec de ton script Google (Apps Script, déployé en « Application Web »)
GSHEET_URL=
# Jeton : identique à la variable TOKEN du script
GSHEET_TOKEN=
# Rappel mensuel par notification (facultatif). Génère les clés avec : node scripts/vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secret de la tâche planifiée (Vercel l'envoie à /api/remind) : 32 caractères aléatoires minimum
CRON_SECRET=
